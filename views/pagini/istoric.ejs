<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include("../fragmente/head", {
        titluPagina: "Istoric 4Pets",
        descrierePagina: "Scurt istoric al proiectului scolar 4Pets si al magazinului virtual."
    }) %>
</head>
<body>
    <%- include("../fragmente/header") %>

    <main>
        <section class="zona-grid zona-1">
            <h2>Istoric 4Pets</h2>
